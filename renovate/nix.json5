{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'flake.nix inputs; loft01 auto-upgrades from main, so a merged flake.lock is deployed',
  nix: {
    enabled: true,
    lockFileMaintenance: {
      enabled: true,
    },
  },
  packageRules: [
    {
      description: 'Refresh every flake input nightly; loft01 deploys main at its Friday 02:00 autoUpgrade',
      matchManagers: ['nix'],
      matchUpdateTypes: ['lockFileMaintenance'],
      automerge: true,
      labels: ['dependencies'],
      schedule: ['* 0-4 * * *'],
    },
    {
      description: 'A NixOS release bump waits for a review before merge',
      matchManagers: ['nix'],
      matchUpdateTypes: ['minor', 'major'],
      automerge: false,
      labels: ['dependencies', 'needs-review'],
    },
  ],
}
