{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Go modules of packages/; CI commits the new Nix vendorHash to these PRs',
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      description: 'k8s.io minors follow controller-runtime, whose bump raises them to its matching release',
      matchManagers: ['gomod'],
      matchPackageNames: ['k8s.io/**'],
      matchUpdateTypes: ['minor', 'major'],
      enabled: false,
    },
    {
      description: 'controller-runtime is pre-1.0, so a minor can break',
      matchManagers: ['gomod'],
      matchPackageNames: ['sigs.k8s.io/controller-runtime'],
      matchUpdateTypes: ['minor'],
      automerge: false,
      labels: ['dependencies', 'needs-review'],
    },
  ],
}
