{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'What automerges and what waits for a review',
  labels: ['dependencies', 'needs-review'],
  platformAutomerge: false,
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  logLevelRemap: [
    {
      description: 'Expected for registries without release dates (GHCR, Quay); keep it off the Dependency Dashboard',
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: 'info',
    },
  ],
  packageRules: [
    {
      description: 'Automerge all non-major updates, 3 days after release so pulled ones are skipped (only where the registry has release dates)',
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
      minimumReleaseAge: '3 days',
      labels: ['dependencies'],
    },
    {
      description: 'Node majors in CI workflows only affect CI, so they automerge too',
      matchFileNames: ['.github/workflows/**'],
      matchDepNames: ['node'],
      matchUpdateTypes: ['major'],
      automerge: true,
      minimumReleaseAge: '3 days',
      labels: ['dependencies'],
    },
    {
      description: 'Minor bumps of stateful apps get a review; their patches stay automerged',
      matchDepNames: [
        'ghcr.io/immich-app/immich-charts/immich',
        'ghcr.io/immich-app/immich-server',
        'ghcr.io/immich-app/immich-machine-learning',
        'quay.io/keycloak/keycloak',
        'ghcr.io/openbao/charts/openbao',
        'ghcr.io/gtsteffaniak/filebrowser',
      ],
      matchUpdateTypes: ['minor'],
      automerge: false,
      labels: ['dependencies', 'needs-review'],
    },
    {
      description: 'Argo CD upgrades itself, so every bump gets a review',
      matchDepNames: ['ghcr.io/argoproj/argo-helm/argo-cd'],
      automerge: false,
      labels: ['dependencies', 'needs-review'],
    },
  ],
}
