        "y": 12,
        "w": 4,
        "h": 6
      },
      "description": "Disks with smartctl_device_smart_status < 1; the alert is min by (device) with threshold 1.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(smartctl_device_smart_status < 1) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "failed"
