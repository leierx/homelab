      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 11
      },
      "description": "Identity and health per physical disk per exporter instance. WWN and firmware come from node_disk_info; the slot/mirror mapping is a static value mapping built from nixos/disko.nix (z1..z8 by WWN). smartctl calls the boot NVMe nvme0, node-exporter calls it nvme0n1; the node-exporter query renames nvme0n1 to nvme0 once. The table shows the smartctl exporter instance and the node-exporter node name; the device is the group key because the smartctl metrics do not carry a node label. SMART status: 1 = OK, 0 = failed (alert smart-status-failed).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_device, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(label_replace(node_disk_info{device=~\"sd[a-z]+|nvme[0-9]+n[0-9]+\"}, \"device\", \"${1}\", \"device\", \"(nvme[0-9]+)n[0-9]+\"), \"node\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_device_capacity_bytes, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_device_power_on_seconds / 3600, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_device_temperature{temperature_type=\"current\"}, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_device_smart_status, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
