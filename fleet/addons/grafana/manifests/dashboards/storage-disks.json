        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "label_replace(smartctl_scsi_grown_defect_list, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
