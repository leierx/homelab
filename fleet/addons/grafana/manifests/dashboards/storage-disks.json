          },
          "expr": "label_replace(smartctl_write_total_uncorrected_errors, \"exporter\", \"$1\", \"instance\", \"(.*)\")",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "device": {
                "operation": "groupby",
                "aggregations": []
              },
              "exporter": {
                "operation": "groupby",
                "aggregations": []
              },
              "Value #A": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "Value #B": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              },
              "Value #C": {
                "operation": "aggregate",
                "aggregations": [
                  "max"
                ]
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
