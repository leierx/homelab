    {
      "id": 16,
      "type": "timeseries",
      "title": "Reserved vs available (tank)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "description": "The tank root dataset. `used` includes the child PVCs' refreservations (zfs-localpv sets refreservation = volsize on the zfs class); `available` is what ZFS will still hand to new datasets and snapshots. zpool allocated and the 80% alert ignore reservations, so the pool can look ~0% used while this available value is exhausted and zfs-thin writes/sanoid snapshots start failing.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_dataset_used_bytes{name=\"tank\"}",
          "instant": false,
          "range": true,
          "legendFormat": "used (incl. reservations) {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_dataset_available_bytes{name=\"tank\"}",
          "instant": false,
          "range": true,
          "legendFormat": "available {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
