    {
      "id": 3,
      "type": "bargauge",
      "title": "Allocated / size",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 7,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "Physical pool allocation over the alert threshold (80%): zfs_pool_allocated_bytes / zfs_pool_size_bytes. This excludes zvol refreservations; the Reserved vs available panel shows the space that actually limits new PVCs and snapshots.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_pool_allocated_bytes / zfs_pool_size_bytes",
          "instant": true,
          "range": false,
          "legendFormat": "{{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
