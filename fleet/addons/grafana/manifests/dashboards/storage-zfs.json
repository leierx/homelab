    {
      "id": 1,
      "type": "stat",
      "title": "Pool health",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "description": "pdf/zfs_exporter health code: 0 ONLINE, 1 DEGRADED, 2 FAULTED, 3 OFFLINE, 4 UNAVAIL, 5 REMOVED, 6 SUSPENDED. The alert fires when health + readonly > 0. The instance label keeps same-named pools on different nodes separate.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_pool_health",
          "instant": true,
          "range": false,
          "legendFormat": "{{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "UNAVAIL",
                  "color": "red",
                  "index": 4
                },
                "5": {
                  "text": "REMOVED",
                  "color": "red",
                  "index": 5
                },
                "6": {
                  "text": "SUSPENDED",
                  "color": "red",
                  "index": 6
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Read-only",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "description": "zfs_pool_readonly: 0 read-write, 1 read-only. Part of the zfs-pool-unhealthy alert condition.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_pool_readonly",
          "instant": true,
          "range": false,
          "legendFormat": "{{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "read-write",
                  "index": 0,
                  "color": "green"
                },
                "1": {
                  "text": "READ-ONLY",
                  "index": 1,
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
