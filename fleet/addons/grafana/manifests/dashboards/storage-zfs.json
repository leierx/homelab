      },
      "description": "clamp_min(delta(zfs_dataset_used_by_dataset_bytes[24h]), 0) for live exporter series, top 8. delta() is used instead of increase() because usedbydataset is a gauge (increase() treats any freed blocks or compaction dip as a counter reset). On zfs-localpv's thick zvols `used` is flat (volsize + snapshots), so usedbydataset is the live data. The aggregate root dataset is excluded.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "topk(8, clamp_min(delta(zfs_dataset_used_by_dataset_bytes{name=~\"tank/.+\"}[24h]) and on(pod, instance, name) zfs_dataset_used_by_dataset_bytes, 0))",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}} {{name}}"
        }
