    {
      "id": 7,
      "type": "timeseries",
      "title": "Allocation over time",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "description": "Physical allocation ratio over time. This is the same metric as the 80% alert and excludes refreservations. The fill-rate projection is the instant Days until 80% stat, so the graph and stat cannot disagree. The dashed line is the alert threshold.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "zfs_pool_allocated_bytes / zfs_pool_size_bytes",
          "instant": false,
          "range": true,
          "legendFormat": "allocated {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Days until 80%",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 4,
        "h": 9
      },
      "description": "Fill-rate projection from the last 7 days of physical allocation, evaluated once. May be empty while the pool is static or shrinking: no value means no growth at the current rate, not a broken panel. This excludes refreservations, so it is not a promise that new PVCs will fit.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "clamp_min((0.8 * zfs_pool_size_bytes - zfs_pool_allocated_bytes) / (deriv(zfs_pool_allocated_bytes[7d]) > 0) / 86400, 0)",
          "instant": true,
          "range": false,
          "legendFormat": "{{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
