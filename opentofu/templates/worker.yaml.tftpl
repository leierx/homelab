#cloud-config
hostname: ${hostname}
users:
  - name: kairos
    groups: [admin]
    lock_passwd: true
    ssh_authorized_keys:
      # loftserveren01's key — VMs are only reachable from the server
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDXMmejnVvbXN04wV48vuX+/IwNMaWt9G3H9/fWD48DF leier@loftserveren01"
# grow the last partition into the clone's bigger disk (no-op when already full)
stages:
  boot:
    - name: "Grow COS_PERSISTENT to fill the disk"
      layout:
        device:
          label: COS_PERSISTENT
        expand_partition:
          size: 0 # 0 = all remaining space
k3s-agent:
  enabled: true
  args:
    - "--server=https://${bootstrap_cp_ip}:6443"
    - "--token=${token}"
