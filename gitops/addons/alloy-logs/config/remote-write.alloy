loki.write "loki" {
  endpoint {
    url                 = sys.env("LOKI_URL")
    retry_on_http_429   = true
    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = "10"
  }

  external_labels = {
    cluster          = sys.env("CLUSTER_NAME"),
    k8s_cluster_name = sys.env("CLUSTER_NAME"),
  }
}
