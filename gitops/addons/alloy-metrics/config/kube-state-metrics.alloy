// the kube-state-metrics Service's endpoints; the job name and the one label
// are what the dashboards and alerts query
discovery.kubernetes "kube_state_metrics" {
  role = "endpoints"

  selectors {
    role  = "endpoints"
    label = "app.kubernetes.io/name=kube-state-metrics,app.kubernetes.io/instance=kube-state-metrics"
  }
}

discovery.relabel "kube_state_metrics" {
  targets = discovery.kubernetes.kube_state_metrics.targets

  rule {
    replacement  = "kubernetes"
    target_label = "source"
  }
}

prometheus.scrape "kube_state_metrics" {
  targets         = discovery.relabel.kube_state_metrics.output
  job_name        = "integrations/kubernetes/kube-state-metrics"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  scheme          = "http"

  tls_config {
    insecure_skip_verify = true
  }

  clustering {
    enabled = true
  }

  forward_to = [prometheus.remote_write.mimir.receiver]
}
