{
  "extends": ["config:recommended"],
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/Oslo",
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "helmv3", "kubernetes", "custom.regex"],
  "automergeStrategy": "merge-commit",
  "platformAutomerge": false,
  "kubernetes": {
    "managerFilePatterns": ["/^gitops/addons/.+/templates/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "versions annotated with a `# renovate:` comment",
      "managerFilePatterns": ["/^gitops/addons/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+:\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "GitHub release assets in kustomizations",
      "managerFilePatterns": ["/^gitops/addons/.+/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "one PR per addon: everything under gitops/addons/<addon>/ shares a group",
      "matchFileNames": ["gitops/addons/**"],
      "groupName": "{{ lookup (split packageFileDir '/') 2 }}",
      "commitMessageSuffix": "({{ lookup (split packageFileDir '/') 2 }})"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchFileNames": ["gitops/addons/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchFileNames": ["gitops/addons/**"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
