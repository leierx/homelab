{
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/Oslo",
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "kubernetes", "kustomize", "custom.regex", "terraform"],
  "automergeStrategy": "merge-commit",
  "platformAutomerge": false,
  "kubernetes": {
    "managerFilePatterns": ["/^gitops/(charts|addon-extras|apps)/.+/templates/.+\\.ya?ml$/"]
  },
  "terraform": {
    "managerFilePatterns": ["/^iac/tofu/.+\\.tf$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "versions annotated with a `# renovate:` comment",
      "managerFilePatterns": ["/^gitops/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?\\s+\\S+:\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "the argocd-diff-preview image in the diff-preview workflow, by tag and digest",
      "managerFilePatterns": ["/^\\.github/workflows/diff-preview\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARGOCD_DIFF_PREVIEW_IMAGE: \\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "GitHub release assets in kustomizations",
      "managerFilePatterns": ["/^gitops/.+/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "one PR per addon or app: everything under its folder shares a group",
      "matchFileNames": ["gitops/charts/**", "gitops/addon-extras/**", "gitops/manifests/**", "gitops/apps/**"],
      "groupName": "{{ lookup (split packageFileDir '/') 2 }}",
      "commitMessageSuffix": "({{ lookup (split packageFileDir '/') 2 }})"
    },
    {
      "description": "one PR per stack: a stack is one Kubernetes minor's tested chart versions",
      "matchFileNames": ["gitops/stacks/**"],
      "groupName": "{{ lookup (split packageFileDir '/') 2 }}",
      "commitMessageSuffix": "({{ lookup (split packageFileDir '/') 2 }})"
    },
    {
      "description": "one PR per OpenTofu root: iac/tofu/<cluster>/<root> groups on the root's name",
      "matchFileNames": ["iac/tofu/**"],
      "groupName": "{{ lookup (split packageFileDir '/') 3 }}",
      "commitMessageSuffix": "({{ lookup (split packageFileDir '/') 3 }})"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchFileNames": ["gitops/charts/**", "gitops/addon-extras/**", "gitops/manifests/**", "gitops/apps/**", "gitops/stacks/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchFileNames": ["gitops/charts/**", "gitops/addon-extras/**", "gitops/manifests/**", "gitops/apps/**", "gitops/stacks/**"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "a cluster adopts a new stack version without review: the tag only freezes versions CI rendered",
      "matchFileNames": ["gitops/bootstrap/members/**"],
      "matchDatasources": ["git-tags"],
      "versioning": "regex:^stack-(?<compatibility>\\d+\\.\\d+)\\.(?<patch>\\d+)$",
      "automerge": true
    },
    {
      "description": "The Keycloak operator, the image it runs, the realm's provider and the reconcile image wait for review",
      "matchFileNames": ["gitops/manifests/keycloak-operator/**", "gitops/charts/keycloak/**", "iac/tofu/*/keycloak/**"],
      "automerge": false
    },
    {
      "description": "Immich, its Postgres and VectorChord wait for review: upgrades can need manual steps (docs/immich.md)",
      "matchFileNames": ["gitops/apps/immich/**"],
      "automerge": false
    },
    {
      "description": "the VectorChord extension image is tagged pg<major>-v<version>; values.yaml holds only the version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tensorchord/vchord-scratch"],
      "extractVersion": "^pg18-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "description": "the realm root's providers come from the OpenTofu registry; Renovate defaults to the Terraform one",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    }
  ]
}
