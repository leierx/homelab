// Renovate reads this only from the repo root; the presets in renovate/ load from main, so edits there apply once merged.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'local>leierx/homelab//renovate/managers.json5',
    'local>leierx/homelab//renovate/labels.json5',
    'local>leierx/homelab//renovate/review.json5',
    'local>leierx/homelab//renovate/schedule.json5',
    'local>leierx/homelab//renovate/holds.json5',
  ],
  includePaths: ['fleet/**', 'tofu/**', '.github/**'],
}
