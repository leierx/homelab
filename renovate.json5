// Renovate configuration for this repository (Renovate reads it only from the repo root).
// Version sources Renovate understands:
//   fleet/**/addon.yaml                           upstream charts (`# renovate:` above targetRevision)
//   fleet/**/values.yaml                          image.repository / image.tag style Helm values
//   fleet/addons/**, fleet/clusters/**            kustomization `images:` and plain `image:` fields,
//                                                 remote bases (?ref=, GitHub release download URLs),
//                                                 OpenTofu providers
//   anywhere in fleet/                            a value on the line after `# renovate: datasource=... depName=...`
//   .github/workflows/                            GitHub Actions, pinned to digests
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  includePaths: ['fleet/**', 'tofu/**', '.github/**'],
  labels: ['dependencies', 'needs-review'],
  pruneBranchAfterAutomerge: true,
  platformAutomerge: false,
  ignoreTests: true,
  customManagers: [
    {
      customType: 'regex',
      description: 'the argocd-diff-preview image in the workflow, by tag and digest',
      managerFilePatterns: ['/^\\.github/workflows/argocd-diff-preview\\.yml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ARGOCD_DIFF_PREVIEW_IMAGE:\\s*\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:\\S+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Values annotated with a `# renovate:` comment on the line above',
      managerFilePatterns: ['/^fleet/.+\\.ya?ml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+registryUrl=(?<registryUrl>\\S+))?(\\s+versioning=(?<versioning>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[^\\n]*[:=]\\s*"?(?<currentValue>[^\\s":]+)"?\\s*(\\n|$)',
      ],
    },
    {
      customType: 'regex',
      description: 'GitHub release assets referenced from kustomizations',
      managerFilePatterns: ['/^fleet/.+/kustomization\\.ya?ml$/'],
      matchStrings: [
        'https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  'helm-values': {
    managerFilePatterns: ['/^fleet/.+/values\\.ya?ml$/'],
  },
  kubernetes: {
    managerFilePatterns: ['/^fleet/(addons|clusters)/.+\\.ya?ml$/'],
  },
  packageRules: [
    {
      description: 'Label PRs by fleet area',
      matchFileNames: ['fleet/addons/**'],
      addLabels: ['fleet/addon'],
    },
    {
      description: 'Label PRs by fleet area',
      matchFileNames: ['fleet/clusters/**'],
      addLabels: ['fleet/cluster'],
    },
    {
      description: 'OpenTofu roots resolve providers from the OpenTofu registry, not Terraform',
      matchFileNames: ['tofu/**', 'fleet/**'],
      matchDatasources: ['terraform-provider', 'terraform-module'],
      registryUrls: ['https://registry.opentofu.org'],
    },
    {
      description: 'Automerge all non-major updates',
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
      labels: ['dependencies'],
    },
    {
      description: 'Run minor, patch and digest updates twice a week',
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      schedule: ['* 0-4 * * 1,4'],
    },
    {
      description: 'Major bumps wait for explicit approval on the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      automerge: false,
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'needs-review'],
    },
    {
      description: 'Argo CD upgrades itself; never batch it with anything else',
      matchDepNames: ['ghcr.io/argoproj/argo-helm/argo-cd'],
      automerge: false,
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'needs-review'],
    },
    {
      description: 'smartctl-exporter v0.15.0 (chart 0.18.0) fails SCSI scrapes with unregistered descriptors (prometheus-community/smartctl_exporter#397)',
      matchDepNames: ['ghcr.io/prometheus-community/charts/prometheus-smartctl-exporter'],
      allowedVersions: '!/^0\\.18\\.0$/',
    },
  ],
}
